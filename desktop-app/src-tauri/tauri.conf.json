{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARS",
  "version": "1.0.0",
  "identifier": "com.ars.app",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "ARS - Automated Requesting System",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,

        "url": "https://ars-server.your-tailnet.ts.net"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
